// TEMPORARY PUBLIC DEMO ONLY. Not private group access.
// Expires 10 December 2026 UTC. Deploy real auth rules before real data.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /demos/coach-calendar {
      allow read: if request.time < timestamp.date(2026, 12, 10);
      allow create: if request.time < timestamp.date(2026, 12, 10)
        && request.resource.data.keys().hasOnly(['revision', 'state'])
        && request.resource.data.revision == 1
        && request.resource.data.state.schema == 1;
      allow update: if request.time < timestamp.date(2026, 12, 10)
        && request.resource.data.keys().hasOnly(['revision', 'state'])
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.state.schema == 1;
      allow delete: if false;
    }
  }
}
